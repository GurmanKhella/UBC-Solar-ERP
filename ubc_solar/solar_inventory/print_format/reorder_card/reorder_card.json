 "html": "<style>\n.solar-label { font-family: Inter, Arial, sans-serif; border: 2px solid #111; border-radius: 8px; padding: 10px 12px; width: 88mm; display: flex; gap: 12px; align-items: center; page-break-inside: avoid; }\n.solar-label .solar-qr { width: 30mm; height: 30mm; }\n.solar-label .t { font-size: 18px; font-weight: 700; line-height: 1.2; }\n.solar-label .s { font-size: 11px; color: #444; margin-top: 4px; }\n.solar-label .big { font-size: 13px; margin-top: 6px; }\n</style>\n<div class=\"solar-label\">\n  {{ qr_svg(\"Reorder Point\", doc.name) }}\n  <div>\n    <div class=\"t\">{{ doc.item_name or doc.item_code }}</div>\n    <div class=\"s\">{{ doc.item_code }} \u00b7 orders {{ \"%g\"|format(doc.reorder_qty or 0) }} {{ doc.uom or \"\" }}</div>\n    <div class=\"big\">{% if doc.method == \"Two-bin\" %}This bin is empty? Scan, then swap in the backup bin.{% else %}Reached this card? Scan it to reorder.{% endif %}</div>\n  </div>\n</div>\n",
